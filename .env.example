# Contact form email delivery.
#
# The form sends enquiries to CONTACT_TO_EMAIL through this SMTP account.
# For Gmail, use an App Password (not your normal account password):
# https://support.google.com/accounts/answer/185833
#
# Copy this file to .env.local and fill in the values. Without SMTP_USER
# and SMTP_PASS, the form falls back to opening a prefilled email in the
# visitor's email app so enquiries can still be sent.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=kenfabaluminium@gmail.com
SMTP_PASS=replace-with-google-app-password
CONTACT_TO_EMAIL=kenfabaluminium@gmail.com
